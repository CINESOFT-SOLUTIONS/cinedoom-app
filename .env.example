# Conexao PostgreSQL (Neon Serverless)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/cinedoom?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/cinedoom?sslmode=require"

# Autenticacao (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cinedoom-super-secret-key-at-least-32-chars-long"

# Criptografia de Dados Pessoais (LGPD - AES-256-GCM / 32 bytes hex)
CINEDOOM_CPF_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Hash Cego para Busca de CPF (LGPD - HMAC-SHA256 / 32 bytes hex)
CINEDOOM_CPF_HMAC_KEY="abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

# Provedor de E-mail Transacional (Resend Free Tier)
RESEND_API_KEY=""

# Observabilidade (Axiom Free Tier)
AXIOM_TOKEN=""
AXIOM_DATASET="cinedoom-production-logs"
